# Copy to .env.local for local dev (gitignored). In production set these in Vercel → Settings → Environment Variables.
# Never prefix these with VITE_ — that would ship them to the browser.

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Current fast/cheap Flash model id — check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Upstash Redis (added automatically by the Vercel Marketplace integration). Optional locally: rate limiting is skipped if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string used to hash client IPs before they reach Redis
RATE_LIMIT_SALT=
